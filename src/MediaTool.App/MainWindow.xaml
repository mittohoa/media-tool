<Window x:Class="MediaTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winnow"
        Height="880" Width="1500" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" Padding="16,12"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeaderTitle" Text="Loading catalog…"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderDetail" Text="" Margin="16,0,0,0"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="WholeCatalogButton" Content="Whole catalog" Click="OnShowWholeCatalog"
                            Visibility="Collapsed" Margin="0,0,8,0"
                            ToolTip="Stop narrowing to the folders chosen in the last scan."/>
                    <Button x:Name="ScanButton" Content="Scan…" Click="OnOpenScanSetup" Margin="0,0,8,0"/>
                    <Button x:Name="SettingsButton" Content="Folders…" Click="OnOpenSettings" Margin="0,0,8,0"
                            ToolTip="Where the catalog lives, and where quarantined files go."/>
                    <Button x:Name="IdenticalButton" Content="Apply identical…" Click="OnApplyIdentical"
                            Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="ExportButton" Content="Export plan…" Click="OnExportPlan"
                            IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Content="Apply…" Click="OnApply" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- cluster list -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ListBox x:Name="ClusterList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnClusterSelected"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                                Padding="14,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#0E639C"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Root" Property="Background" Value="#2A2D2E"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding ReclaimableText}" DockPanel.Dock="Right"
                                               Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               FontSize="13" FontWeight="SemiBold"/>
                                </DockPanel>
                                <DockPanel Margin="0,3,0,0">
                                    <TextBlock Text="{Binding StateText}" DockPanel.Dock="Right"
                                               Foreground="{Binding StateBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{StaticResource TextDim}" FontSize="11"/>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- comparison pane -->
            <Grid Grid.Column="1">
                <TextBlock x:Name="EmptyMessage" Text="" TextWrapping="Wrap" MaxWidth="560"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="14"/>

                <ScrollViewer x:Name="CardScroller" VerticalScrollBarVisibility="Auto" Padding="16">
                  <StackPanel>
                    <Border x:Name="TruncationBanner" Visibility="Collapsed"
                            Background="#33E58A2E" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="8,0,8,4">
                        <TextBlock x:Name="TruncationText" Text="" TextWrapping="Wrap"
                                   Foreground="{StaticResource Warn}" FontSize="12"/>
                    </Border>

                    <!-- attributes side by side, so the winner of each row is read rather
                         than reconstructed from three separate blocks of text -->
                    <Border x:Name="ComparisonPanel" Visibility="Collapsed"
                            Background="{StaticResource BgCard}" CornerRadius="6"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            Padding="14,10" Margin="8,4,8,10">
                        <Grid x:Name="ComparisonGrid"/>
                    </Border>

                    <ItemsControl x:Name="FileCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" CornerRadius="6"
                                        BorderBrush="{Binding BorderBrush}" BorderThickness="2"
                                        Margin="8" Width="330" Cursor="Hand"
                                        MouseLeftButtonUp="OnCardClicked">
                                    <StackPanel>
                                        <Grid Height="240" Background="#1A1A1A">
                                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="6"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Warn}" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextAlignment="Center" Margin="12"/>
                                            <Border Background="#B0000000" CornerRadius="3" Padding="6,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                <TextBlock Text="{Binding Ordinal}" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                            <Border Background="{Binding BorderBrush}" CornerRadius="3" Padding="7,2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                <TextBlock Text="{Binding ActionText}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Margin="12,10,12,12">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}" Foreground="{StaticResource TextDim}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,6"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Dimensions}" FontSize="12"/>
                                                <TextBlock Text="  ·  " Foreground="{StaticResource TextDim}" FontSize="12"/>
                                                <TextBlock Text="{Binding SizeText}" FontSize="12"/>
                                                <TextBlock Text="  " FontSize="12"/>
                                                <TextBlock Text="{Binding QualityText}" FontSize="12"
                                                           Foreground="{StaticResource TextDim}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding MetadataText}" FontSize="12" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding CameraText}" FontSize="11"
                                                       Foreground="{StaticResource TextDim}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- where this copy differs from the one being kept -->
                                        <StackPanel Margin="12,0,12,12">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDifference}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="3" Height="76" Background="#101318">
                                                <Image Source="{Binding Difference}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>

                                            <TextBlock Text="{Binding DifferenceVerdict}" FontSize="11"
                                                       Foreground="{Binding DifferenceBrush}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>

                                            <TextBlock Text="{Binding DifferenceMeasurements}" FontSize="10"
                                                       Foreground="{StaticResource TextDim}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- footer -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" Padding="16,10"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                           Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"
                           Text="1–9 choose keeper   ·   Enter confirm and next   ·   S skip   ·   ↑↓ move   ·   O open folder"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
